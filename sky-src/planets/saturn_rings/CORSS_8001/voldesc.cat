    ELECTRONIC_MAIL_ID       = "mgordon@seti.org"
  END_OBJECT                 = DATA_PRODUCER
     
  OBJECT                     = CATALOG
    ^MISSION_CATALOG             = "MISSION.CAT"
    ^INSTRUMENT_HOST_CATALOG     = "INSTHOST.CAT"
